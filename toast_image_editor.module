<?php

/**
 * @file
 * Toast Image Editor module implementation.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\media\MediaInterface;
use Drupal\toast_image_editor\Form\SettingsForm;

/**
 * Implements hook_form_FORM_ID_alter() for "form_media_form".
 */
function toast_image_editor_form_media_form_alter(array &$form, FormStateInterface $form_state): void {
  $formObject = $form_state->getFormObject();
  if (!method_exists($formObject, 'getEntity')) {
    return;
  }

  $media = $formObject->getEntity();
  if (!$media instanceof MediaInterface) {
    return;
  }

  // Only add an image editor for image media types with existing files.
  /** @var \Drupal\toast_image_editor\Service\ImageProcessorService $imageProcessor */
  $imageProcessor = \Drupal::service('toast_image_editor.image_processor');
  if (!$imageProcessor->canEditMedia($media)) {
    return;
  }

  // Check permissions.
  $currentUser = \Drupal::currentUser();
  if (!$currentUser->hasPermission('use toast image editor')) {
    return;
  }

  // Add the image editor section.
  $form['toast_image_editor'] = [
    '#type' => 'fieldset',
    '#title' => t('Image Editor'),
    '#weight' => 10,
  ];

  $form['toast_image_editor']['editor_container'] = [
    '#type' => 'container',
    '#attributes' => [
      'id' => 'toast-image-editor-container',
      'data-media-id' => $media->id(),
    ],
  ];

  $form['toast_image_editor']['editor_placeholder'] = [
    '#markup' => '<div id="toast-image-editor"></div>',
  ];

  // Add a hidden field to store image editor data.
  $form['toast_image_editor_data'] = [
    '#type' => 'hidden',
    '#value' => '',
  ];

  // Attach the JavaScript library.
  $form['#attached']['library'][] = 'toast_image_editor/toast-image-editor-integration';

  // Pass configuration to JavaScript.
  $config = \Drupal::config('toast_image_editor.settings');
  $form['#attached']['drupalSettings']['toastImageEditor'] = [
    'width' => $config->get('editor_width') ? $config->get('editor_width') . 'px' : '100%',
    'height' => $config->get('editor_height') ? $config->get('editor_height') . 'px' : '600px',
    'theme' => $config->get('theme') ?: 'white',
    'mediaId' => $media->id(),
    'saveUrl' => \Drupal::service('url_generator')->generateFromRoute('toast_image_editor.media_save', ['media' => $media->id()]),
    'enabledTools' => $config->get('enabled_tools') ?: SettingsForm::defaultTools(),
    'imageUrl' => $imageProcessor->getImageUrl($media),
  ];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for "media".
 */
function toast_image_editor_media_presave(MediaInterface $entity): void {
  // Check if this is a media entity with image editor data.
  // @todo Make sure it's an image media type.
  $request = \Drupal::request();
  $imageData = $request->request->get('toast_image_editor_data');

  if (!empty($imageData) && str_starts_with($imageData, 'data:image/')) {
    /** @var \Drupal\toast_image_editor\Service\ImageProcessorService $imageProcessor */
    $imageProcessor = \Drupal::service('toast_image_editor.image_processor');

    try {
      // Process the edited image data (without saving the media entity).
      $imageProcessor->saveEditedImage($entity, $imageData);
      \Drupal::logger('toast_image_editor')->info('Image updated for media @id', ['@id' => $entity->id()]);
    }
    catch (\Exception $e) {
      \Drupal::logger('toast_image_editor')->error('Failed to save edited image for media @id: @message', [
        '@id' => $entity->id(),
        '@message' => $e->getMessage(),
      ]);
    }
  }
}
