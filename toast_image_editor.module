<?php

/**
 * @file
 * Toast Image Editor module implementation.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\toast_image_editor\Hook\ToastImageEditorHooks;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\media\MediaInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function toast_image_editor_help(string $route_name, RouteMatchInterface $route_match): string
{
    return \Drupal::service(ToastImageEditorHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_form_FORM_ID_alter() for "form_media_form".
 */
#[LegacyHook]
function toast_image_editor_form_media_form_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service(ToastImageEditorHooks::class)->formMediaFormAlter($form, $form_state);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for "media".
 */
#[LegacyHook]
function toast_image_editor_media_presave(MediaInterface $entity): void {
  \Drupal::service(ToastImageEditorHooks::class)->mediaPresave($entity);
}
